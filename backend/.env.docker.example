# ============================================
# PanelForge Backend - Docker 环境配置
# ============================================
# 此文件用于 Docker 部署，不包含 DATABASE_URL 和 REDIS_URL
# 这两个变量由 docker-compose.yml 的 environment 段提供
# 复制此文件为 .env.docker 并填入真实密钥

# ============================================
# 基础设置
# ============================================
APP_NAME=PanelForge-backend
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ============================================
# CORS 跨域配置
# ============================================
CORS_ORIGINS=["http://localhost:15173", "http://127.0.0.1:15173"]

# ============================================
# LLM 服务配置 (Agnes AI API - OpenAI 兼容)
# ============================================
ANTHROPIC_BASE_URL=https://apihub.agnes-ai.com/v1
ANTHROPIC_AUTH_TOKEN=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=agnes-2.0-flash

# ============================================
# 图像生成服务配置
# ============================================
IMAGE_PROVIDER=openai
IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
IMAGE_API_KEY=your_api_key_here
IMAGE_MODEL=agnes-image-2.0-flash
IMAGE_ENDPOINT=/images/generations
ENABLE_IMAGE_TO_IMAGE=false
FAKE_IMAGE_FIXTURE_URL=

# ============================================
# 视频生成服务配置
# ============================================
VIDEO_PROVIDER=openai
VIDEO_BASE_URL=https://apihub.agnes-ai.com/v1
VIDEO_API_KEY=your_api_key_here
VIDEO_MODEL=agnes-video-v2.0
VIDEO_ENDPOINT=/videos
ENABLE_IMAGE_TO_VIDEO=true
VIDEO_IMAGE_MODE=first_frame
VIDEO_INLINE_LOCAL_IMAGES=true

# ============================================
# 豆包视频配置
# ============================================
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
DOUBAO_VIDEO_DURATION=5
DOUBAO_VIDEO_RATIO=adaptive
DOUBAO_GENERATE_AUDIO=true

# ============================================
# 其他设置
# ============================================
REQUEST_TIMEOUT_S=120.0

# ============================================
# 文本生成服务配置
# ============================================
TEXT_PROVIDER=openai
TEXT_BASE_URL=https://apihub.agnes-ai.com/v1
TEXT_API_KEY=your_api_key_here
TEXT_MODEL=agnes-2.0-flash
TEXT_ENDPOINT=/chat/completions
TEXT_ENABLE_THINKING=false
FAKE_TEXT_RESPONSE=这是 Fake 文本 Provider 的本地测试响应
